{
  "name": "audit-workflow-desktop",
  "version": "0.1.1",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "start-api": "python -m desktop.api",
    "dist": "powershell -NoProfile -ExecutionPolicy Bypass -File ../packaging/build.ps1"
  },
  "devDependencies": {
    "electron": "^25.0.0",
    "electron-builder": "^24.13.3"
  },
  "build": {
    "appId": "com.audit.workflow",
    "productName": "AuditWorkflow",
    "directories": {
      "output": "../dist"
    },
    "files": [
      "main.js",
      "preload.js",
      "renderer/**",
      "package.json",
      "!**/.env",
      "!**/.env.*"
    ],
    "extraResources": [
      {
        "from": "../audit_workflow",
        "to": "app/audit_workflow",
        "filter": [
          "**/*.py",
          "**/*.md",
          "!**/.env",
          "!**/.env.*"
        ]
      },
      {
        "from": "../desktop",
        "to": "app/desktop",
        "filter": [
          "**/*.py",
          "!**/.env",
          "!**/.env.*"
        ]
      },
      {
        "from": "../config",
        "to": "app/config",
        "filter": [
          "config.blm.detect.yaml",
          "config.task_definitions.yml",
          "!**/.env",
          "!**/.env.*"
        ]
      },
      {
        "from": "../requirements.txt",
        "to": "app/requirements.txt"
      },
      {
        "from": "../config.example.matching.yml",
        "to": "app/config.example.matching.yml"
      },
      {
        "from": "../inputs",
        "to": "app/sample_inputs",
        "filter": [
          "佰腾/**",
          "桂平金山/**",
          "TMF2/**",
          "!**/.env",
          "!**/.env.*"
        ]
      },
      {
        "from": "runtime/python",
        "to": "runtime/python"
      },
      {
        "from": "wheels",
        "to": "wheels"
      },
      {
        "from": "../config/config.llm.production.yml",
        "to": "app/config/config.llm.production.yml"
      }
    ],
    "asar": true,
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "signAndEditExecutable": false
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "AuditWorkflow"
    }
  }
}
